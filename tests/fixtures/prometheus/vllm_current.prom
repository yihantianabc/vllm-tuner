# HELP vllm:num_requests_running Number of requests currently running.
# TYPE vllm:num_requests_running gauge
vllm:num_requests_running{model_name="test/model"} 3
# TYPE vllm:num_requests_waiting gauge
vllm:num_requests_waiting{model_name="test/model"} 2
# TYPE vllm:kv_cache_usage_perc gauge
vllm:kv_cache_usage_perc{model_name="test/model"} 0.75
# TYPE vllm:num_preemptions_total counter
vllm:num_preemptions_total{model_name="test/model"} 7
# TYPE vllm:prompt_tokens_total counter
vllm:prompt_tokens_total{model_name="test/model"} 1200
# TYPE vllm:generation_tokens_total counter
vllm:generation_tokens_total{model_name="test/model"} 600
# TYPE vllm:prefix_cache_queries counter
vllm:prefix_cache_queries{model_name="test/model"} 100
# TYPE vllm:prefix_cache_hits counter
vllm:prefix_cache_hits{model_name="test/model"} 60
# TYPE vllm:time_to_first_token_seconds histogram
vllm:time_to_first_token_seconds_bucket{model_name="test/model",le="0.1"} 2
vllm:time_to_first_token_seconds_bucket{model_name="test/model",le="0.5"} 8
vllm:time_to_first_token_seconds_bucket{model_name="test/model",le="+Inf"} 10
vllm:time_to_first_token_seconds_sum{model_name="test/model"} 2.4
vllm:time_to_first_token_seconds_count{model_name="test/model"} 10
# TYPE vllm:request_queue_time_seconds histogram
vllm:request_queue_time_seconds_bucket{model_name="test/model",le="0.01"} 5
vllm:request_queue_time_seconds_bucket{model_name="test/model",le="+Inf"} 10
vllm:request_queue_time_seconds_sum{model_name="test/model"} 0.2
vllm:request_queue_time_seconds_count{model_name="test/model"} 10
# EOF
